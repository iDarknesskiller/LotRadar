# Generated installer packages and build output (ship as release artifacts, never commit)
dist/
build/
*.zip
*.exe
*.msi

# Python
__pycache__/
*.py[cod]
.venv/
venv/
setup-venv/

# Runtime state, user data and private data -- never commit
data/
runtime/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
photos/
photo_cache/
browser-profile/
browser_profile/
profiles/
*.log

# Secrets
.env
.env.*
*.pem
*.key
*.pfx
secrets*
*token*
*credentials*

# Branding. Only the four Owner-approved public assets are tracked (branding/business_card.png,
# branding/dedication.jpg, branding/lotradar_logo.png and LotRadar.ico at the root); every other file
# in branding/ stays private and ignored. Publishing anything else needs a new Owner approval.
branding/*
!branding/business_card.png
!branding/dedication.jpg
!branding/lotradar_logo.png
private-assets/
